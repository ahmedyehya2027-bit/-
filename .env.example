# Supabase project settings (Netlify: Site configuration > Environment variables)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the Publishable key from Supabase API settings (recommended)
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Legacy alternative only; use one key variable, not both
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
